# Per-agent secrets - NEVER commit. Copy to agents/<name>/.env.

# Slack - one app per agent. Create the Slack app in the agent's
# workspace first, then paste tokens here.
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-
SLACK_SIGNING_SECRET=

# Model provider - populate the one matching zeroclaw_provider in agent.toml.
ANTHROPIC_API_KEY=
LITELLM_BASE_URL=
LITELLM_API_KEY=

# Composio (optional - leave empty to disable).
COMPOSIO_API_KEY=
COMPOSIO_ENTITY_ID=default
