# Anthropic
ANTHROPIC_API_KEY=

# Composio — sign up at https://app.composio.dev, copy API key from dashboard
COMPOSIO_API_KEY=

# Slack app (Socket Mode)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Populated by `python scripts/setup_agent.py`
ENVIRONMENT_ID=
AGENT_ID=

# Populated by `python scripts/setup_composio.py`
# One auth config per toolkit (Composio manages the underlying Google OAuth app)
GMAIL_AUTH_CONFIG_ID=
CALENDAR_AUTH_CONFIG_ID=

# Local session store
SESSION_DB_PATH=./sessions.db
