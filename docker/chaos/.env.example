# Remote-side .env template for Chaos.
#
# This file is the TEMPLATE. The live file lives at /opt/openclaw/chaos/.env
# on Server 3, is mode 0600 owned by overlord101, and is rendered by
# infra/tasks/chaos_deploy.py from Pyinfra's local os.environ.
#
# Never commit a populated copy of this file.

# ============================================
# Image pin — tag + digest, e.g. ghcr.io/openclaw/openclaw:2026.4.14@sha256:<digest>
# ============================================
CHAOS_IMAGE=

# ============================================
# Container timezone
# ============================================
TZ=UTC

# ============================================
# Gateway bearer token — generate with: openssl rand -hex 32
# Rotate if ever leaked (chat, logs, commits).
# ============================================
CHAOS_GATEWAY_TOKEN=

# ============================================
# LiteLLM (Server 2) — OpenAI-compatible proxy
# ============================================
CHAOS_LITELLM_BASE_URL=
CHAOS_LITELLM_API_KEY=

# ============================================
# Slack — scaffolding slot, empty on day one.
# Fill when wiring Slack channel per design's follow-ups.
# ============================================
CHAOS_SLACK_BOT_TOKEN=
CHAOS_SLACK_APP_TOKEN=
CHAOS_SLACK_SIGNING_SECRET=

# ============================================
# SearXNG — scaffolding slot, empty on day one.
# Fill when adding the searxng service per design's follow-ups.
# ============================================
CHAOS_SEARXNG_BASE_URL=
