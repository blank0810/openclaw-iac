# Generated by infra/tasks/agent_new.py - do not edit on the server.
# Source of truth: docker/agent/config/config.toml.j2 (this file).
# Re-run `scripts/agentctl new <agent-name>` to regenerate.

schema_version = 2

workspace_dir = "/zeroclaw-data/workspace"
config_path = "/zeroclaw-data/.zeroclaw/config.toml"

{% if provider == "litellm" -%}
# Routed via Cloudesk's LiteLLM proxy on Server 2 (10.0.0.4:4000) — provides
# rate-limit pooling, multi-provider fallback, and virtual-key rotation. The
# api_key below is a LiteLLM virtual key, not an upstream provider key. Treat
# the host's tenant config.toml accordingly (mode 0640, mounted
# read-only into the container, never echoed to logs). Flip
# ZEROCLAW_PROVIDER=anthropic and re-deploy to bypass the proxy and call
# Anthropic directly again.
default_provider = "custom:{{ litellm_base_url }}"
api_key = "{{ litellm_api_key }}"
{%- else -%}
# Direct Anthropic API. The LiteLLM proxy on Server 2 is bypassed for this
# deploy — flip ZEROCLAW_PROVIDER=litellm and re-deploy to route through it.
# Until then, this key is the live secret on Server 3: treat the host's
# the host's tenant config.toml accordingly (mode 0640, overlord101-owned,
# mounted read-only into the container).
default_provider = "anthropic"
api_key = "{{ anthropic_api_key }}"
{%- endif %}
default_model = "{{ zeroclaw_model }}"
default_temperature = 0.7

[gateway]
port = 42617
host = "[::]"
allow_public_bind = true
require_pairing = false

[agent]
max_tool_iterations = 50
max_tool_result_chars = 50000
max_context_tokens = 32000

[agent.context_compression]
enabled = true
tool_result_retrim_chars = 2000

[memory]
backend = "sqlite"
auto_save = true
hygiene_enabled = true
archive_after_days = 7
purge_after_days = 30
embedding_provider = "none"

{% if composio_api_key -%}
# Composio managed-OAuth tools (REST path) — registers a single `composio`
# tool with connect/list_accounts/execute sub-actions. Coarser approval
# granularity than the MCP path below; lower token overhead per turn.
# Deliberately NOT in [autonomy].auto_approve below: every composio call
# is an outbound side-effect that should gate on per-invocation approval.
[composio]
enabled = true
api_key = "{{ composio_api_key }}"
entity_id = "{{ composio_entity_id }}"

{% endif -%}
{% if composio_mcp_url -%}
# Composio MCP path — connects to Composio's hosted MCP server, which
# exposes each toolkit action as a first-class tool with prefix
# `composio__<tool>`. Higher token overhead unless deferred_loading is
# kept on (default: true). Per-tool approval granularity — the operator
# can whitelist `composio__calendar_list_events` while still gating
# `composio__gmail_send_email`. Treat the bearer below as a live secret.
[mcp]
enabled = true
# deferred_loading = false -> all MCP tool schemas are eagerly exposed in
# every Anthropic tool_use request. Higher per-turn token cost, but
# reliable: the model gets real tool_use schemas instead of falling back
# to text-XML emulation when schemas are hidden behind a `tool_search`
# discovery step the agent often forgets to invoke.
deferred_loading = false

[[mcp.servers]]
name = "composio"
transport = "{{ composio_mcp_transport }}"
url = "{{ composio_mcp_url }}"
{% if composio_mcp_api_key -%}
headers = { "{{ composio_mcp_auth_header }}" = "{{ composio_mcp_api_key }}" }
{% endif %}
{% endif -%}
{% if slack_bot_token -%}
# Slack channel — token-based Events API flow, no public inbound port needed.
# Tokens come from the local .env (SLACK_BOT_TOKEN / SLACK_APP_TOKEN). The
# allowlist below is enforced in-runtime: empty list = deny all, ["*"] =
# accept all senders (treat as temporary verification only). Scope to the
# operator's Slack user ID once it's known.
[channels_config.slack]
bot_token = "{{ slack_bot_token }}"
{% if slack_app_token -%}
app_token = "{{ slack_app_token }}"
{% endif -%}
{% if slack_channel_id -%}
channel_id = "{{ slack_channel_id }}"
{% endif -%}
{% if slack_allowed_users -%}
allowed_users = {{ slack_allowed_users }}
{%- else -%}
allowed_users = ["*"]
{%- endif %}
mention_only = {{ slack_mention_only }}
thread_replies = {{ slack_thread_replies }}
use_markdown_blocks = {{ slack_use_markdown_blocks }}
# stream_drafts=false: post a single complete reply instead of progressively
# editing a draft via chat.update. Quieter UX, avoids visual flicker of
# partial messages, and skips the chat.update token burn while typing.
stream_drafts = {{ slack_stream_drafts }}

{% endif -%}
# Supervised autonomy by default — tool surface gets layered on after we
# confirm the runtime is healthy end-to-end. Keep auto_approve narrow until
# ZeroClaw has been observed in production.
[autonomy]
level = "supervised"
auto_approve = [
    "file_read",
    "memory_recall",
    "memory_store",
    "calculator",
    "glob_search",
    "content_search",
    # tool_search is the MCP tool-discovery built-in; needed in headless
    # channels even when deferred_loading=false, because some flows still
    # use it to filter available tools by toolkit/app.
    "tool_search",
{%- if composio_mcp_url %}
    # Composio MCP meta-tools — auto-approved because headless channels
    # (Slack/webhook) have nowhere to land a per-call approval prompt;
    # without these the agent silently fails on OAuth/tool-execution flows.
    # Security trade-off: the agent can autonomously search Composio's
    # catalog, initiate connections, run tools, and execute remote bash
    # in Composio's sandbox. The remaining gates are: (1) which OAuth
    # scopes you grant per app during connection, (2) Composio's own
    # per-app permissions, (3) the workspace prompts asking the agent
    # to ask before destructive actions. Tighten by removing entries
    # below if specific tools (REMOTE_BASH, MULTI_EXECUTE) shouldn't
    # run unattended.
    "composio__COMPOSIO_SEARCH_TOOLS",
    "composio__COMPOSIO_GET_TOOL_SCHEMAS",
    "composio__COMPOSIO_MANAGE_CONNECTIONS",
    "composio__COMPOSIO_WAIT_FOR_CONNECTIONS",
    "composio__COMPOSIO_MULTI_EXECUTE_TOOL",
    "composio__COMPOSIO_REMOTE_WORKBENCH",
    "composio__COMPOSIO_REMOTE_BASH_TOOL",
{%- endif %}
]
