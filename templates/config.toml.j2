# Managed by zeroclawctl. Rendered from agents/{{ agent.name }}/agent.toml.
# Real secrets live in zeroclaw.env (mode 0600), never in this file.

[identity]
name = "{{ agent.name }}"
display_name = "{{ agent.display_name }}"

[runtime]
workspace = "/zeroclaw/workspace"

[llm]
provider = "{{ agent.llm.provider }}"
model = "{{ agent.llm.model }}"
timeout_secs = {{ agent.llm.timeout_secs }}

[slack]
enabled = {{ "true" if agent.slack.enabled else "false" }}

[composio]
enabled = {{ "true" if agent.composio.enabled else "false" }}
{% if agent.composio.enabled %}allowed_tools = [{% for tool in agent.composio.allowed_tools %}"{{ tool }}"{% if not loop.last %}, {% endif %}{% endfor %}]
{% endif %}

[policy]
require_approval_for = [{% for rule in agent.policy.require_approval_for %}"{{ rule }}"{% if not loop.last %}, {% endif %}{% endfor %}]
denied_domains = [{% for domain in agent.policy.denied_domains %}"{{ domain }}"{% if not loop.last %}, {% endif %}{% endfor %}]

{% if agent.exec_enabled %}[security.exec]
deny_patterns = [
{% for pattern in exec_deny_patterns %}  "{{ pattern }}",
{% endfor %}]
{% endif %}
