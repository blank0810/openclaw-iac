[Unit]
Description=ZeroClaw Slack liveness probe for {{ tenant.name }}
After=docker.service
Wants=docker.service
ConditionPathExists=/opt/zeroclaw/bin/zeroclaw-slack-probe.sh

[Service]
Type=oneshot
EnvironmentFile=/opt/zeroclaw/states/{{ tenant.state_dir }}/zeroclaw.env
Environment="CONTAINER_NAME=zeroclaw-{{ tenant.name }}"
Environment="PROBE_STATE_DIR=/var/lib/zeroclaw-probe/{{ tenant.name }}"
Environment="PROBE_LOG_FILE=/var/log/zeroclaw-probe-{{ tenant.name }}.log"
ExecStart=/opt/zeroclaw/bin/zeroclaw-slack-probe.sh
ProtectSystem=strict
ReadWritePaths=/var/lib/zeroclaw-probe /var/log/zeroclaw-probe-{{ tenant.name }}.log
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
