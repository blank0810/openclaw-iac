# ============================================
# Server IPs — NEVER commit real values
# ============================================
SERVER1_IP=                              # Ollama (Model Server)
SERVER2_IP=                              # LiteLLM Proxy (API Gateway)
SERVER3_IP=                              # OpenClaw Agents (this server)

# ============================================
# SSH / Pyinfra connection (Server 3)
# ============================================
SSH_KEY_PATH=./hetzner-cloudesk.pem
SSH_USER=overlord101
SSH_PORT=2222                            # Hardened port (bootstrap connects with --port 22 override)

# ============================================
# Shared API Keys (used by all agents)
# ============================================
TZ=UTC
ANTHROPIC_API_KEY=                       # From https://console.anthropic.com — primary model provider
GEMINI_API_KEY=                          # Google AI Studio — secondary model provider
LITELLM_BASE_URL=                        # http://<SERVER2_IP>:4000
LITELLM_API_KEY=                         # sk-not-needed if LiteLLM has no auth
OLLAMA_BASE_URL=                         # http://<SERVER1_IP>:11434
BRAVE_API_KEY=                           # From https://brave.com/search/api — free: 2000 queries/month
SEARXNG_SECRET=                          # Generate: openssl rand -hex 32 (optional, Chaos SearXNG sidecar)
OPENAI_API_KEY=                          # For DALL-E image generation (optional)

# ============================================
# Composio MCP (Gmail, Calendar, Trello)
# ============================================
# NOTE: Composio API key is NOT set here. Each agent self-configures it via chat.
# DM the agent with your Composio API key and it registers the MCP servers itself.
# Get your key at: https://app.composio.dev (free tier available)

# ============================================
# Jarvis Agent (existing)
# ============================================
OPENCLAW_GATEWAY_TOKEN=                  # Generate: openssl rand -hex 32
SLACK_BOT_TOKEN=                         # xoxb-... from OAuth & Permissions
SLACK_APP_TOKEN=                         # xapp-... from Socket Mode setup
TELEGRAM_BOT_TOKEN=                      # From @BotFather /newbot
DISCORD_BOT_TOKEN=                       # Developer Portal > Bot > Reset Token
DISCORD_SERVER_ID=                       # Right-click server > Copy Server ID
DISCORD_OWNER_ID=                        # Right-click your avatar > Copy User ID
WHATSAPP_OWNER_PHONE=                    # E.164 format: +639XXXXXXXXX

# ============================================
# Chaos Agent (new)
# ============================================
CHAOS_GATEWAY_TOKEN=                     # Generate: openssl rand -hex 32 (MUST be different)
CHAOS_SLACK_BOT_TOKEN=                   # xoxb-... from SECOND Slack app
CHAOS_SLACK_APP_TOKEN=                   # xapp-... from SECOND Slack app (Socket Mode)
CHAOS_TELEGRAM_BOT_TOKEN=
CHAOS_DISCORD_BOT_TOKEN=
CHAOS_DISCORD_SERVER_ID=
CHAOS_DISCORD_OWNER_ID=
CHAOS_WHATSAPP_OWNER_PHONE=
