# ============================================
# Required infra vars — consumed by lib/config.py::load_config()
# ============================================
# SERVER_HOST: target server IP or hostname (no default; must be set)
SERVER_HOST=
# DEPLOY_USER: admin user created at bootstrap, used for repeat deploys (default: overlord101)
DEPLOY_USER=overlord101
# SSH_PORT: post-hardening SSH port — UFW only opens this one (default: 2222)
SSH_PORT=2222
# DEPLOY_SSH_KEY_PATH: private key for DEPLOY_USER on the hardened host
DEPLOY_SSH_KEY_PATH=./hetzner-cloudesk.pem
# ROOT_SSH_KEY_PATH: private key used for the one-time root bootstrap
# (often the same .pem as DEPLOY_SSH_KEY_PATH on Hetzner)
ROOT_SSH_KEY_PATH=./hetzner-cloudesk.pem
# ZEROCLAW_IMAGE: pinned container image tag (prefer digest) deployed to the host
ZEROCLAW_IMAGE=ghcr.io/zeroclaw-labs/zeroclaw:v0.7.3-debian

# ============================================
# Per-agent secrets — NOT in this file anymore
# ============================================
# Per-agent runtime secrets (LLM keys, Slack tokens, Composio keys) now live
# in `agents/<slug>/agent.toml` under their respective TOML sections:
#   [llm]      api_key       (provider + model + api_key + timeout_secs)
#   [slack]    bot_token, app_token, signing_secret
#   [composio] api_key, allowed_tools
# See lib/config.py (LlmConfig L18, SlackConfig L32, ComposioConfig L46).
# Each agent.toml file should be mode 0600 and gitignored.
#
# Deprecated env vars — moved to per-agent agent.toml, do NOT set here:
#   ANTHROPIC_API_KEY      -> agents/<slug>/agent.toml [llm].api_key (provider=anthropic)
#   LITELLM_API_KEY        -> agents/<slug>/agent.toml [llm].api_key (provider=litellm)
#   SLACK_BOT_TOKEN        -> agents/<slug>/agent.toml [slack].bot_token
#   SLACK_APP_TOKEN        -> agents/<slug>/agent.toml [slack].app_token
#   SLACK_SIGNING_SECRET   -> agents/<slug>/agent.toml [slack].signing_secret
#   COMPOSIO_API_KEY       -> agents/<slug>/agent.toml [composio].api_key
